@using Gmax.Models.ViewModels.AssegnazioneModal
@using Gmax.Models.ViewModels.OrdineProdCompCK
@* @model OrdineProdCompCKListViewModel *@
@model AssegnazioneModalViewModel

@{
    var descr = string.Empty;
    if (Model.Articolo != null && !string.IsNullOrWhiteSpace(Model.Articolo?.Descrizione))
    {
        descr = Model.Articolo.Descrizione;
        if (descr.Length > 15)
        {
            descr = descr.Substring(0, 15);
        }
    }

    var ordineProdCompCKVcId = string.Concat("#", string.Join("_", "opc", Model.TipoArticolo.Trim(), Model.CodiceArticolo.Trim(), Model.NroLancio, Model.NroSottolancio));
    string tipoArt_codArt_prefix = string.Join("_", Model.TipoArticolo.Trim(), Model.CodiceArticolo.Trim());
    var modalName = string.Join("_", tipoArt_codArt_prefix, "Modal");
    var formId = string.Join("_", Model.NroLancio, Model.NroSottolancio, tipoArt_codArt_prefix);
    var dataBsTarget = "#" + modalName;
    var selectId = string.Join("_", tipoArt_codArt_prefix, "DisponibilitaSelect");
    var qtaDisponibileOrigine = string.Join("_", tipoArt_codArt_prefix, "QtaDispStart");
    var firstSelectOption = Model.DisponibilitaMagazzini?.FirstOrDefault()?.Value ?? "0";
}

<!-- Modal -->
<div class="modal fade" id="magModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <h1 class="modal-title fs-5" id="exampleModalLabel">Versamento</h1>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="assegnazioneModalForm" asp-action="AssegnaValoreAMagazzino" asp-controller="OrdineProduzioneCKs" method="post" 
                      data-ajax="true"
                      data-ajax-mode="replace"
                      data-ajax-update="#modal-container"
                      data-ajax-success="openModal">
                    <div class="row d-flex row-cols-2 mb-1">
                        <div class="col">
                            <div class="form-group">
                                <label for="@Model.NroLancio" class="control-label">Lancio</label>
                                <input asp-for="@Model.NroLancio" class="form-control" style="background-color:white" readonly />
                            </div>
                        </div>
                        <div class="col">
                            <div class="form-group">
                                <label for="NroSottolancio" class="control-label">Sottolancio</label>
                                <input asp-for="@Model.NroSottolancio" class="form-control" style="background-color:white" readonly />
                            </div>
                        </div>
                    </div>
                    <div class="row d-flex row-cols-3 mb-1">
                        <div class="col">
                            <div class="form-group">
                                <label for="TipoArticolo" class="control-label">Tipo Comp.</label>
                                <input asp-for="@Model.TipoArticolo" class="form-control" style="background-color:white" readonly />
                            </div>
                        </div>
                        <div class="col">
                            <div class="form-group">
                                <label for="CodiceArticolo" class="control-label">Codice Comp.</label>
                                <input asp-for="@Model.CodiceArticolo" class="form-control" style="background-color:white" readonly />
                            </div>
                        </div>
                        <div class="col">
                            <div class="form-group">
                                <label for="Descrizione" class="control-label">Descrizione</label>
                                <input id="Descrizione" value="@descr" class="form-control" style="background-color:white" disabled readonly />
                            </div>
                        </div>
                    </div>
                    <hr />
                    <h5>Effettua Versamento</h5>
                    <div class="row mb-3">
                        <div class="col">
                            <div class="form-group">
                                <label for="@Model.MagazzinoOrigineSelezionato" class="form-label">Magazzino Origine</label>
                                <select id="magSelect" asp-for="@Model.MagazzinoOrigineSelezionato" class="form-select" data-select-id="@selectId" data-input-field="@qtaDisponibileOrigine" onchange="updateTargetFromSelect(this)">
                                    @foreach (var mag in Model?.DisponibilitaMagazzini)
                                    {
                                        <option value="@mag.Text" data-qtamag="@mag.Value" data-codmag="@mag.Text">@mag.Text</option>
                                    }
                                </select>
                                <span asp-validation-for="MagazzinoOrigineSelezionato" class="text-danger"></span>
                            </div>
                        </div>
                        <input type="hidden" asp-for="@Model.MagazzinoOrigineSelezionato" id="codSelectedMag" />
                        <div class="col">
                            <div class="form-group">
                                <label for="@qtaDisponibileOrigine" class="form-label">Qta Disponibile</label>
                                <input id="@qtaDisponibileOrigine" class="form-control" style="background-color:white" readonly value="@firstSelectOption" />
                            </div>
                        </div>
                        <div class="col col-auto d-flex align-items-center justify-content-center">
                            <i class="bi bi-arrow-right-square" style="font-size:64px; line-height:1;"></i>
                        </div>
                        <div class="col">
                            <div class="form-group">
                                <label for="MagDestinazione" class="form-label">Magazzino Destinazione</label>
                                <input asp-for="@Model.MagazzinoDestinazione" class="form-control" style="background-color:white" readonly />
                            </div>
                        </div>
                        <div class="col">
                            <div class="form-group">
                                <label for="QtaDisponibileDestinazione" class="form-label">Qta Disponibile</label>
                                <input asp-for="@Model.QtaDisponibileMagDestinazione" class="form-control" style="background-color:white" disabled readonly />
                            </div>
                        </div>
                    </div>
                    <div class="row d-flex row-cols-3 mb-1">
                        <div class="col">
                            <div class="form-group">
                                <label for="QtaVersamento" class="form-label">Quantità Versamento</label>
                                <input asp-for="@Model.QtaVersamento" class="form-control" style="background-color:white" type="number"
                                       min="0"
                                       placeholder="0.00"
                                       value="0"/>
                                <span asp-validation-for="QtaVersamento" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                <button type="submit" class="btn btn-primary" data-bs-dismiss="modal" form="assegnazioneModalForm">Save changes</button>
            </div>
        </div>
    </div>
</div>