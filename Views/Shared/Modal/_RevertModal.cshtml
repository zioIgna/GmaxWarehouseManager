@using Gmax.Models.ViewModels.AssegnazioneModal
@using Gmax.Models.ViewModels.OrdineProdCompCK
@* @model OrdineProdCompCKListViewModel *@
@model AssegnazioneModalViewModel

@{
    var descr = string.Empty;
    if (Model.Articolo != null && !string.IsNullOrWhiteSpace(Model.Articolo?.Descrizione))
    {
        descr = Model.Articolo.Descrizione;
        if (descr.Length > 15)
        {
            descr = descr.Substring(0, 15);
        }
    }

    var ordineProdCompCKVcId = string.Concat("#", string.Join("_", "opc", Model.TipoArticolo.Trim(), Model.CodiceArticolo.Trim(), Model.NroLancio, Model.NroSottolancio));
    string tipoArt_codArt_prefix = string.Join("_", Model.TipoArticolo.Trim(), Model.CodiceArticolo.Trim());
    var modalName = string.Join("_", tipoArt_codArt_prefix, "Modal");
    var formId = string.Join("_", Model.NroLancio, Model.NroSottolancio, tipoArt_codArt_prefix);
    var dataBsTarget = "#" + modalName;
    var selectId = string.Join("_", tipoArt_codArt_prefix, "DisponibilitaSelect");
    var qtaDisponibileOrigine = string.Join("_", tipoArt_codArt_prefix, "QtaDispStart");
    var firstSelectOption = Model.DisponibilitaMagazzini?.FirstOrDefault()?.Value ?? "0";
}

<!-- Modal -->
<div class="modal fade" id="magModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <h1 class="modal-title fs-5" id="exampleModalLabel">Versamento</h1>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="assegnazioneModalForm" asp-action="AssegnaValoreMagazzinoDaRevert" asp-controller="OrdineProduzioneCKs" method="post"
                      data-ajax="true"
                      data-ajax-mode="replace"
                      data-ajax-update="#modal-container"
                      data-ajax-success="openModal">
                    <div class="row d-flex row-cols-2 mb-1">
                        <div class="col">
                            <div class="form-group">
                                <label for="@Model.NroLancio" class="control-label">Lancio</label>
                                <input asp-for="@Model.NroLancio" class="form-control" style="background-color:white" readonly />
                            </div>
                        </div>
                        <div class="col">
                            <div class="form-group">
                                <label for="NroSottolancio" class="control-label">Sottolancio</label>
                                <input asp-for="@Model.NroSottolancio" class="form-control" style="background-color:white" readonly />
                            </div>
                        </div>
                    </div>
                    <div class="row d-flex row-cols-3 mb-1">
                        <div class="col">
                            <div class="form-group">
                                <label for="TipoArticolo" class="control-label">Tipo Comp.</label>
                                <input asp-for="@Model.TipoArticolo" class="form-control" style="background-color:white" readonly />
                            </div>
                        </div>
                        <div class="col">
                            <div class="form-group">
                                <label for="CodiceArticolo" class="control-label">Codice Comp.</label>
                                <input asp-for="@Model.CodiceArticolo" class="form-control" style="background-color:white" readonly />
                            </div>
                        </div>
                        <div class="col">
                            <div class="form-group">
                                <label for="Descrizione" class="control-label">Descrizione</label>
                                <input id="Descrizione" value="@descr" class="form-control" style="background-color:white" disabled readonly />
                            </div>
                        </div>
                    </div>
                    <hr />
                    <h5>Effettua Versamento</h5>
                    <div id="versamento-section">
                        <partial name="/Views/Shared/Modal/_ValorizzazioneRevert.cshtml" model="@Model"></partial>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary me-2" data-bs-dismiss="modal">Chiudi</button>
                <button type="submit" class="btn btn-primary" form="assegnazioneModalForm">Conferma</button>
            </div>
        </div>
    </div>
</div>