@using Gmax.Models.ViewModels.AssegnazioneModal
@model AssegnazioneModalViewModel

@{
    string tipoArt_codArt_prefix = string.Join("_", Model.TipoArticolo.Trim(), Model.CodiceArticolo.Trim());
    var selectId = string.Join("_", tipoArt_codArt_prefix, "DisponibilitaSelect");
    var qtaDisponibileOrigine = string.Join("_", tipoArt_codArt_prefix, "QtaDispStart");
    var firstSelectOption = Model.DisponibilitaMagazzini?.FirstOrDefault()?.Value ?? "0";
}

<div class="row mb-3">
    <div class="col">
        <div class="form-group">
            <label for="MagDestinazione" class="form-label">Magazzino Destinazione</label>
            <input asp-for="@Model.MagazzinoDestinazione" class="form-control" style="background-color:white" readonly />
        </div>
    </div>
    <div class="col">
        <div class="form-group">
            <label for="QtaDisponibileDestinazione" class="form-label">Qta Disponibile</label>
            <input asp-for="@Model.QtaDisponibileMagDestinazione" class="form-control" style="background-color:white" disabled readonly />
        </div>
    </div>
    <div class="col col-auto d-flex align-items-center justify-content-center">
        <i class="bi bi-arrow-left-square" style="font-size:64px; line-height:1;"></i>
    </div>
    <div class="col">
        <div class="form-group">
            <label for="@Model.MagazzinoOrigineSelezionato" class="form-label">Magazzino Origine</label>
            <select id="magSelect" asp-for="@Model.MagazzinoOrigineSelezionato" class="form-select" data-select-id="@selectId" data-input-field="@qtaDisponibileOrigine" onchange="updateTargetFromSelect(this)">
                @foreach (var mag in Model?.DisponibilitaMagazzini)
                {
                    <option value="@mag.Text" data-qtamag="@mag.Value" data-codmag="@mag.Text">@mag.Text</option>
                }
            </select>
            <span asp-validation-for="MagazzinoOrigineSelezionato" class="text-danger"></span>
        </div>
    </div>
    <input type="hidden" asp-for="@Model.MagazzinoOrigineSelezionato" id="codSelectedMag" />
    <div class="col">
        <div class="form-group">
            <label for="@qtaDisponibileOrigine" class="form-label">Qta Disponibile</label>
            <input id="@qtaDisponibileOrigine" class="form-control" style="background-color:white" readonly value="@firstSelectOption" />
        </div>
    </div>
</div>
<input type="hidden" asp-for="@Model.PreviousAssegnazione" />
<div class="row d-flex mb-1">
    <div class="col-sm-4">
        <div class="form-group">
            <label for="QtaVersamento" class="form-label">Quantità Versamento</label>
            <input asp-for="@Model.QtaVersamento" class="form-control" style="background-color:white" type="number"
                   min="0"
                   placeholder="0.00"
                   value="0" />
            <span asp-validation-for="QtaVersamento" class="text-danger"></span>
        </div>
    </div>
    @if (Model.PreviousAssegnazione != 0)
    {
        <div class="col-sm-8">
            <div class="card">
                <div class="card-body" style="background-color: beige;">
                    <div class="row">
                        <div class="col-sm-9" style="color: red">Versamento concluso con successo.<br /> E' possibile annullare l'operazione.<br /> Cliccare il bottone per rivedere le quantità versate.</div>
                        <div class="col-sm-3 col-auto d-flex align-items-center justify-content-center">
                            <a class="btn btn-outline-secondary"
                               asp-controller="OrdineProduzioneCKs"
                               asp-action="InvertiVersamento"
                               asp-route-assegnazioneId="@Model.PreviousAssegnazione"
                               data-ajax="true"
                               data-ajax-mode="replace"
                               data-ajax-update="#versamento-section"
                               data-ajax-method="post">
                                <i class="bi bi-arrow-left-square me-1"></i> Inverti
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>